# Von den update_*.sh-Skripten heruntergeladene Pakete
*.rpm
*.flatpak
# Zwischendateien laufender/abgebrochener Downloads
*.part

# Marker-Dateien der Flatpak-Skripte (zuletzt installierte Version/Release-Tag)
.*-installed-version

# Lokale Claude-Code-Einstellungen (können freigegebene Befehle samt Zugangsdaten enthalten)
.claude/settings.local.json
